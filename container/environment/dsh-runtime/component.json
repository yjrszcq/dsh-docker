{
  "schema": 1,
  "id": "dsh-runtime",
  "type": "service",
  "command": {
    "executable": "/run/dsh-platform/views/runtime/bin/dsh",
    "args": ["web", "--patch", "/run/dsh-platform/views/system-plugins/cordis.patch.yml", "--host", "127.0.0.1", "--port", "3079"],
    "timeoutSeconds": 30
  },
  "environment": {
    "HOME": "/home/node",
    "LOGNAME": "node",
    "USER": "node",
    "DSH_BUNDLED_SKILL_DIR": "/run/dsh-platform/views/skills",
    "XDG_CACHE_HOME": "/home/node/.cache",
    "XDG_CONFIG_HOME": "/home/node/.config",
    "XDG_DATA_HOME": "/home/node/.local/share"
  },
  "lifecycle": {
    "prepare": null,
    "preStart": null,
    "postStart": {
      "executable": "/usr/local/bin/node",
      "args": ["/run/dsh-platform/views/bootstrap/control-plane/hooks/dsh-web-ready.mjs"],
      "timeoutSeconds": 30
    },
    "preStop": null,
    "stop": null,
    "postStop": null
  },
  "health": {
    "type": "http",
    "host": "127.0.0.1",
    "port": 3079,
    "path": "/",
    "intervalSeconds": 1,
    "timeoutSeconds": 30
  },
  "logging": {
    "stdout": true,
    "stderr": true
  }
}
