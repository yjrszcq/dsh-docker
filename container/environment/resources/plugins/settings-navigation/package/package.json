{
  "name": "@dsh-docker/settings-navigation",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.bundle.js",
    "./package.json": "./package.json"
  },
  "dshDocker": {
    "description": {
      "zh": "优化 DSH 设置目录滚动和窄屏分级导航。",
      "en": "Improve DSH Settings directory scrolling and compact navigation."
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
