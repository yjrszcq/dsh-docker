{
  "name": "@dsh-docker/platform-management",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.bundle.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "undici": "8.10.0"
  },
  "dshDocker": {
    "description": {
      "zh": "管理 DSH Docker 更新、运行维护、系统资源与登录会话。",
      "en": "Manage DSH Docker updates, runtime maintenance, system resources, and login sessions."
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "react": "^18.2.0"
  }
}
