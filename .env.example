# Docker image
DSH_IMAGE_TAG=latest

# Host port binding
DSH_LISTEN_ADDRESS=127.0.0.1
DSH_PORT=3080

# Local directory mounted as /workspace
DSH_WORKSPACE=./workspace

# Initial workspace directory shown inside the container
DSH_DEFAULT_WORKSPACE=/workspace

# true disables telemetry; false enables it
DSH_TELEMETRY_DISABLED=true

# Required for access through a LAN IP or domain. Do not include a scheme or path.
# Example: 192.168.1.100 or dsh.example.com
DSH_TRUSTED_HOST=
