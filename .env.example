# Docker image
DSH_IMAGE_TAG=latest

# Host port binding
DSH_LISTEN_ADDRESS=127.0.0.1
DSH_PORT=3080

# Local directory mounted as /workspace
DSH_WORKSPACE=./workspace

# Allow the agent to run any command as root through passwordless sudo
DSH_SUDO_ENABLED=true

# Initial workspace directory shown inside the container
DSH_DEFAULT_WORKSPACE=/workspace

# true disables telemetry; false enables it
DSH_TELEMETRY_DISABLED=true

# Optional HTTP Basic username. Ignored when the gateway password is empty.
DSH_PROXY_USERNAME=

# Optional gateway password. Empty means no gateway authentication.
DSH_PROXY_PASSWORD=

# Inject a crypto.randomUUID compatibility shim when the browser lacks it
DSH_PROXY_POLYFILL=true

# Required for access through LAN IPs or domains. Use comma-separated host[:port]
# values without schemes or paths. Empty accepts loopback Hosts only; * accepts any Host.
DSH_TRUSTED_HOSTS=
